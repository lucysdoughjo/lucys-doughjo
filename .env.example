# Sanity (create project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Read token: Sanity → Project → API → Tokens (Viewer or Editor for draft preview later)
SANITY_API_READ_TOKEN=

# Write token: Editor role — used by npm run seed:sanity and inventory updates
SANITY_API_WRITE_TOKEN=

# Keep the Sanity dataset private. Orders store customer name, email, phone, and address.

# Webhook secret: choose a long random string; same value in Sanity webhook URL
SANITY_REVALIDATE_SECRET=

# Optional: hosted Studio hostname (sanity deploy)
SANITY_STUDIO_HOSTNAME=

# Public site URL (canonical links, Open Graph, email assets)
NEXT_PUBLIC_SITE_URL=https://lucydoughjo.com

# Contact form (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lucy's Doughjo <hello@lucysdoughjo.com>"

# Stripe (test mode first — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Local: from `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=

# Vercel Cron: Authorization Bearer token for /api/cron/expire-holds
CRON_SECRET=
