# Sanity (create project at https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Read token: Sanity → Project → API → Tokens (Viewer or Editor for draft preview later)
SANITY_API_READ_TOKEN=

# Write token: Editor role — used by npm run seed:sanity and future inventory updates
SANITY_API_WRITE_TOKEN=

# Webhook secret: choose a long random string; same value in Sanity webhook URL
SANITY_REVALIDATE_SECRET=

# Optional: hosted Studio hostname (sanity deploy)
SANITY_STUDIO_HOSTNAME=

# Contact form (Resend — https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Lucy's Doughjo <hello@lucysdoughjo.com>"
